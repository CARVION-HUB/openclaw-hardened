# ============================================================
# OpenClaw -- Variaveis de Ambiente
# ============================================================
# INSTRUCOES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha TODOS os valores abaixo
#   3. NUNCA commite .env no controle de versao
#   4. Rotacione todos os segredos a cada 90 dias no maximo
# ============================================================

# ----------------------------------------------------------
# OpenClaw Gateway
# ----------------------------------------------------------
# Token de autenticacao do gateway (gerado automaticamente pelo setup.sh)
# Para gerar manualmente: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_RUN_SETUP_SH

# Imagem Docker do OpenClaw (nao mude se construiu localmente)
OPENCLAW_IMAGE=openclaw:local

# Bind mode: "lan" para acesso na rede local, "localhost" para acesso local apenas
OPENCLAW_GATEWAY_BIND=lan

# Porta do gateway (WebSocket + Control UI)
OPENCLAW_GATEWAY_PORT=18789

# Porta do bridge
OPENCLAW_BRIDGE_PORT=18790

# ----------------------------------------------------------
# Chaves de API LLM
# ----------------------------------------------------------
# Anthropic: Crie uma chave em https://console.anthropic.com/settings/keys
#   - Configure limites de gasto no workspace
#   - Recomendado: Limite mensal rigido de $50-$100
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# OpenAI (opcional): Crie uma chave em https://platform.openai.com/api-keys
#   - Configure um LIMITE MENSAL RIGIDO em billing
OPENAI_API_KEY=sk-proj-CHANGE_ME

# Claude Web Session (opcional, para modo web)
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=

# ----------------------------------------------------------
# Tailscale VPN (acesso zero-trust)
# ----------------------------------------------------------
# Gere uma auth key em https://login.tailscale.com/admin/settings/keys
# Use uma chave efemera, pre-autorizada com tag:openclaw
TAILSCALE_AUTHKEY=tskey-auth-CHANGE_ME

# ----------------------------------------------------------
# Caddy (reverse proxy)
# ----------------------------------------------------------
# Dominio para TLS automatico (ou deixe localhost para dev)
CADDY_DOMAIN=localhost

# Email para registro ACME/TLS
ACME_EMAIL=admin@example.com

# ----------------------------------------------------------
# Monitoramento (opcional)
# ----------------------------------------------------------
# URL do webhook para alertas de anomalia (Slack, Discord, etc.)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
